# Maintainer: Nebula Team <contact@nebula.app>
pkgname=trelod-desktop
pkgver=1.0.0
pkgrel=1
pkgdesc="Trelod — anonymous social desktop application (Social network + E2EE chats + Video calls)"
arch=('x86_64')
url="https://trelod.app"
license=('PROPRIETARY')
depends=('electron' 'gtk3' 'nss' 'alsa-lib' 'libxcb' 'libxfixes' 'libxrender' 'libxdamage' 'libgcrypt')
makedepends=('nodejs' 'npm' 'python')
options=('!strip')
source=()
sha256sums=()

package() {
  cd "$startdir"

  # Install the electron app from local source
  install -d "$pkgdir/opt/trelod"
  cp -r main package.json electron-builder.yml scripts "$pkgdir/opt/trelod/"

  # Create launch script
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/trelod" << 'LAUNCHER'
#!/bin/bash
cd /opt/trelod
NEBULA_APP_URL="${NEBULA_APP_URL:-https://trelod.vercel.app}" exec electron main/index.js "$@"
LAUNCHER
  chmod +x "$pkgdir/usr/bin/trelod"

  # Install desktop file
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/trelod.desktop" << 'DESKTOP'
[Desktop Entry]
Name=Trelod
Comment=Anonymous social platform & encrypted messenger
Exec=trelod
Icon=trelod
Type=Application
Categories=Network;InstantMessaging;
X-DesktopNames=trelod
DESKTOP

  # Install icon from the frontend public folder
  install -d "$pkgdir/usr/share/pixmaps"
  install -Dm644 "$startdir/../l_frontend/public/pwa/icon-512.png" \
    "$pkgdir/usr/share/pixmaps/trelod.png"
}