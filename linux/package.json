{
  "name": "trelod-linux",
  "version": "1.0.0",
  "description": "Trelod — desktop application for Arch Linux and other distributions",
  "main": "main/index.js",
  "author": "trelod",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux deb",
    "release": "node scripts/release-linux.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "productName": "trelod",
    "appId": "trelod.linux",
    "linux": {
      "category": "Utility",
      "distributionOptions": {
        "deb": {
          "synopsis": "Trelod — anonymous social desktop application",
          "description": "Full-fledged Trelod client for Linux"
        },
        "appimage": {
          "synopsis": "Trelod — anonymous social desktop application"
        }
      }
    },
    "nsis": {
      "allowToChangeAppDirectory": true
    }
  }
}