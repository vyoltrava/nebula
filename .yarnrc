# Yarn v1 ini syntax: key and value separated by space (not '=').
# ignore-platform: don't fail install on os/cpu-mismatched optional packages
# (e.g. @rolldown/binding-openharmony-arm64 is openharmony/arm64-only but
# harmless if installed on linux/x64). Do NOT use ignore-optional — that
# skips lightningcss-linux-x64-gnu which next build actually requires.
ignore-platform true
ignore-engines true
