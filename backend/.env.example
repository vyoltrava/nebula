# ============================================================
# NEBULA BACKEND — переменные окружения
# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env в git!
# ============================================================

# --- ОБЯЗАТЕЛЬНО ---
# Генерация: python scripts/generate_secret.py  или  openssl rand -hex 48
# ВНИМАНИЕ: смена ключа инвалидирует ВСЕ JWT-сессии пользователей.
SECRET_KEY=

# --- База данных ---
# В продакшене ОБЯЗАТЕЛЬНО Postgres (SQLite — только для локальной разработки)
DATABASE_URL=sqlite:///nebula.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/nebula

# --- Redis (rate limiting, брутфорс-защита) ---
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0   |  FAKE = заглушка в памяти

# --- Токены ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Окружение ---
ENV=development
FRONTEND_URL=http://localhost:3000

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sentry (мониторинг ошибок) ---
SENTRY_DSN=

# --- Push (Web Push / VAPID) ---
VAPID_PRIVATE_PEM=
VAPID_PUBLIC_B64=

# --- Прочее ---
ALLOW_SVG_UPLOADS=false

